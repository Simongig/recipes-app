# Copy this file to backend/.env for local development.
# Never commit real credentials — this file documents required variables only.

# Local dev (with docker-compose MongoDB):
MONGODB_URI=mongodb://localhost:27017/database

# Or your Atlas URI for prod:
# MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority

MONGODB_DATABASE=database

# Generate a secure random value for prod, e.g.:
#   openssl rand -base64 32
JWT_SECRET=replace-with-a-secure-random-string

# Cloudflare R2 (image uploads). Dashboard -> R2:
#   R2_ACCOUNT_ID         Account ID (shown on the R2 overview page)
#   R2_ACCESS_KEY_ID /
#   R2_SECRET_ACCESS_KEY  "Manage API tokens" -> create token with "Object Read & Write",
#                         scoped to the bucket. The secret is only shown once.
#   R2_BUCKET_NAME        Name of the bucket
#   R2_PUBLIC_URL         Bucket -> Settings -> Public access: the r2.dev URL or a custom domain
#                         (no trailing slash), e.g. https://images.kochbuch.io
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
